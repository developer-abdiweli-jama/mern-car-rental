# Backend environment variables (placeholder values only - do not commit real secrets)

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/car_rental
TEST_MONGO_URI=mongodb://127.0.0.1:27017/car_rental_test

# JWT access token. Generate a strong random value, e.g. `openssl rand -base64 64`
JWT_SECRET=replace_this_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Cookie security
# Local development uses Lax cookies. Production on Vercel + Render needs None/secure.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CORS_ORIGIN=http://localhost:5173

# Optional local demo data seeding. Use a unique password and keep this file private.
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=change_this_password

# Optional: configure these to enable persistent file uploads in production.
# Public image URLs can be used without Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
